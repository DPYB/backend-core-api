# Database (Supabase PostgreSQL Transaction Pooler 6543 포트)
# 옵션 1: 통합 DATABASE_URL
DATABASE_URL=
# 옵션 2: 개별 환경변수 (특수문자 자동 URL 인코딩 지원, 권장)
DB_USER=postgres.[PROJECT_REF]
DB_PASSWORD=your_database_password
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# Authentication (Auth Service / Google OAuth JWT)
AUTH_DISABLED=false
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256

# External API (국립중앙도서관 서지정보 API 인증키)
NL_API_CERT_KEY=your_national_library_cert_key

# Application Settings
ENV=local
PORT=8000
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.pages.dev
