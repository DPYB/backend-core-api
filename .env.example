# ==============================================================================
# Database (Supabase PostgreSQL Transaction Pooler 6543 포트)
# ==============================================================================
# 옵션 1: 통합 DATABASE_URL (특수문자가 없을 경우)
DATABASE_URL=

# 옵션 2: 개별 환경변수 (비밀번호 내 특수문자 자동 URL 인코딩 지원, Render 배포 권장)
DB_USER=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=your_supabase_database_password
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
# 주의: core-api와 ai-agent는 동일한 JWT_SECRET_KEY를 사용해야 채팅 및 API 인증이 정상 연동됩니다.
AUTH_DISABLED=false
JWT_SECRET_KEY=generate-a-secure-random-32-character-secret-key-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# 로컬 환경에서 원격 Supabase DB 마이그레이션 명시적 허용 플래그 (기본값: false)
# ALLOW_REMOTE_MIGRATION=false
# 기동 시 Base.metadata.create_all 자동 실행 여부 (기본값: false)
# AUTO_CREATE_TABLES=false

# ==============================================================================
# Social Login OAuth (Google Cloud Console & Kakao Developers)
# ==============================================================================
# Google OAuth 2.0 Web Client ID (Google ID Token의 aud 검증용)
# 발급 위치: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Kakao REST API Key 또는 Client ID (선택 검증용)
# 발급 위치: https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=your-kakao-client-id

# ==============================================================================
# External API & Microservice Integration
# ==============================================================================
# 국립중앙도서관 서지정보 API 인증키 (ISBN 검색 및 도서 메타데이터 조회)
# 발급 위치: https://www.nl.go.kr/seoji/
NL_API_CERT_KEY=your_national_library_cert_key

# AI Agent 백엔드 연동 주소 (사서 채팅 및 LLM 추천 에이전트)
AI_AGENT_BASE_URL=http://127.0.0.1:8001

# ==============================================================================
# Application Settings & CORS (Render Web Service 배포)
# ==============================================================================
ENV=production
PORT=8000
PROJECT_NAME=backend-core-api
# 프론트엔드 도메인 (Cloudflare Pages, Vercel, 로컬 개발 포트 등 콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://dont-paw-get.pages.dev
