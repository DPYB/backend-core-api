# Database (Supabase PostgreSQL Transaction Pooler 6543 포트)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?options=-c%20search_path=core

# Authentication (Cognito App Client ID)
AUTH_APP_CLIENT_ID=your_cognito_app_client_id
COGNITO_USER_POOL_ID=
COGNITO_REGION=ap-northeast-2

# External API (국립중앙도서관 서지정보 API 인증키)
NL_API_CERT_KEY=your_national_library_cert_key

# Application Settings
ENV=local
PORT=8000
AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.pages.dev
